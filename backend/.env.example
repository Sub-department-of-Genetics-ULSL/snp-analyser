APP_NAME=SNP Analyser
JOB_WORKERS=1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# HelixFold-single predictor configuration
# If possible, path variables should be absolute
HELIXFOLD_SINGLE_ENABLED=true
HELIXFOLD_SINGLE_REPO_DIR=/snp-analyser/backend/external/HelixFold-single
HELIXFOLD_SINGLE_MODEL_PATH=/snp-analyser/backend/models/helixfold-single.pdparams
HELIXFOLD_SINGLE_PYTHON_BIN=/snp-analyser/backend/external/HelixFold-single/.venv/bin/python
HELIXFOLD_SINGLE_SCRIPT_RELPATH=helixfold_single_inference.py
# HELIXFOLD_SINGLE_TIMEOUT_SECONDS=7200

# Create .env file from this example and fill in the values for the variables above
